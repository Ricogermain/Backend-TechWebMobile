generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id         Int         @id @default(autoincrement())
  nom        String
  email      String      @unique
  motDePasse String
  telephone  String?
  role       Role        @default(CLIENT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  commandes              Commande[]              @relation("ClientCommandes")
  livraisons             Livraison[]             @relation("LivreurLivraisons")
  conversationsAsUser1   Conversation[]          @relation("ConversationParticipant1")
  conversationsAsUser2   Conversation[]          @relation("ConversationParticipant2")
  messagesSent           Message[]               @relation("MessageSender")

  @@map("utilisateurs")
}

model Vehicule {
  id         Int        @id @default(autoincrement())
  marque     String
  modele     String
  annee      Int
  prix       Decimal    @db.Decimal(10, 2)
  imageUrl   String?
  stock      Int        @default(1) // champ vaovao
  disponible Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  commandes  Commande[]

  @@map("vehicules")
}

model Commande {
  id               Int            @id @default(autoincrement())
  idClient         Int
  idVehicule       Int
  adresseLivraison String
  dateCommande     DateTime       @default(now())
  statut           StatutCommande @default(EN_ATTENTE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  client           Utilisateur    @relation("ClientCommandes", fields: [idClient], references: [id])
  vehicule         Vehicule       @relation(fields: [idVehicule], references: [id])
  livraison        Livraison?

  @@map("commandes")
}

model Livraison {
  id                Int             @id @default(autoincrement())
  idCommande        Int             @unique
  idLivreur         Int?
  statut            StatutLivraison @default(PRISE_EN_CHARGE)
  datePriseEnCharge DateTime?
  dateLivraison     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  commande          Commande        @relation(fields: [idCommande], references: [id])
  livreur           Utilisateur?    @relation("LivreurLivraisons", fields: [idLivreur], references: [id])

  @@map("livraisons")
}

model Conversation {
  id           Int       @id @default(autoincrement())
  participant1 Int
  participant2 Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user1        Utilisateur @relation("ConversationParticipant1", fields: [participant1], references: [id])
  user2        Utilisateur @relation("ConversationParticipant2", fields: [participant2], references: [id])
  messages     Message[]

  @@unique([participant1, participant2])
  @@map("conversations")
}

model Message {
  id              Int          @id @default(autoincrement())
  conversationId  Int
  senderId        Int
  contenu         String
  lu              Boolean      @default(false)
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          Utilisateur  @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum Role {
  CLIENT
  ADMIN
  LIVREUR
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum StatutLivraison {
  PRISE_EN_CHARGE
  EN_ROUTE
  LIVREE
  ANNULEE // champ vaovao
}
