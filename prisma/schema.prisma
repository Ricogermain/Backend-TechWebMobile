generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id         Int         @id @default(autoincrement())
  nom        String
  email      String      @unique
  motDePasse String
  telephone  String?
  role       Role        @default(CLIENT)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  commandes   Commande[]   @relation("ClientCommandes")
  livraisons  Livraison[]  @relation("LivreurLivraisons")
  messagesEnvoyes Message[] @relation("MessageExpediteur")

  @@map("utilisateurs")
}

model Vehicule {
  id         Int        @id @default(autoincrement())
  marque     String
  modele     String
  annee      Int
  prix       Decimal    @db.Decimal(10, 2)
  imageUrl   String?
  stock      Int        @default(1) // champ vaovao
  disponible Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  commandes  Commande[]

  @@map("vehicules")
}

model Commande {
  id               Int            @id @default(autoincrement())
  idClient         Int
  idVehicule       Int
  adresseLivraison String
  dateCommande     DateTime       @default(now())
  statut           StatutCommande @default(EN_ATTENTE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  client           Utilisateur    @relation("ClientCommandes", fields: [idClient], references: [id])
  vehicule         Vehicule       @relation(fields: [idVehicule], references: [id])
  livraison        Livraison?
  messages         Message[]

  @@map("commandes")
}

model Livraison {
  id                Int             @id @default(autoincrement())
  idCommande        Int             @unique
  idLivreur         Int?
  statut            StatutLivraison @default(PRISE_EN_CHARGE)
  datePriseEnCharge DateTime?
  dateLivraison     DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  commande          Commande        @relation(fields: [idCommande], references: [id])
  livreur           Utilisateur?    @relation("LivreurLivraisons", fields: [idLivreur], references: [id])

  @@map("livraisons")
}

model Message {
  id           Int       @id @default(autoincrement())
  idCommande   Int
  idExpediteur Int
  contenu      String
  lu           Boolean   @default(false)
  createdAt    DateTime  @default(now())
  commande     Commande  @relation(fields: [idCommande], references: [id], onDelete: Cascade)
  expediteur   Utilisateur @relation("MessageExpediteur", fields: [idExpediteur], references: [id])

  @@index([idCommande, createdAt])
  @@map("messages")
}

enum Role {
  CLIENT
  ADMIN
  LIVREUR
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum StatutLivraison {
  PRISE_EN_CHARGE
  EN_ROUTE
  LIVREE
  ANNULEE // champ vaovao
}
